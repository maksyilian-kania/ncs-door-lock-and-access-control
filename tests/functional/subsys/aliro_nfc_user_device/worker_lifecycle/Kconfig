mainmenu "Aliro NFC User Device - Worker Lifecycle Test"

# Pulls in CONFIG_ALIRO_UD_NFC_* and CONFIG_ALIRO_UD_OS_*: this test builds
# the real platform/nfc/nfc_worker.cpp and platform/os/*.cpp sources
# directly (see CMakeLists.txt), so it needs the same Kconfig options they
# reference, normally sourced via the application's own Kconfig.
rsource "../../../../../applications/aliro-nfc-user-device/src/platform/nfc/Kconfig"
rsource "../../../../../applications/aliro-nfc-user-device/src/platform/os/Kconfig"
rsource "../../../../../applications/aliro-nfc-user-device/src/platform/authorization/Kconfig"
rsource "../../../../../applications/aliro-nfc-user-device/src/storage/credential/Kconfig"
# WP7 stack impact (see docs/wp7_stack_impact.md): the real
# Aliro::UserDeviceStack now unconditionally calls
# Aliro::Interface::UserDevice::Mailbox::*, so this test now also builds
# storage/mailbox/*.cpp (see CMakeLists.txt) and needs its Kconfig options.
rsource "../../../../../applications/aliro-nfc-user-device/src/storage/mailbox/Kconfig"

source "Kconfig.zephyr"
