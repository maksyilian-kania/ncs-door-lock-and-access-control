menu "Access/Revocation Document snapshots"

config ALIRO_UD_MAX_OPEN_DOCUMENT_SNAPSHOTS
	int "Maximum concurrently open Document snapshots"
	default 2
	range 2 8
	help
	  Fixed capacity of the open-snapshot table (APP_PLAN.md AWP5). AUTH1
	  opens both the Access Document and Revocation Document snapshots
	  for one session concurrently, so this must be at least 2.

module = ALIRO_UD_DOCUMENT
module-str = ALIRO_UD_DOCUMENT
module-dep = LOG
module-help = Enables Aliro NFC User Device document-snapshot log messages.
source "$(ZEPHYR_BASE)/subsys/logging/Kconfig.template.log_config"

endmenu # Access/Revocation Document snapshots
