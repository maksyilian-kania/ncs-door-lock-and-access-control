menu "Credential and trust persistence (AWP3)"

config ALIRO_UD_CREDENTIAL_PSA_WANT
	bool
	default y
	# key_backend_psa.cpp / fake_key_backend.cpp: import an Access
	# Credential private-key scalar (ImportPrivateKeyScalar), export its
	# public key, and sign with it (ECDSA P-256/SHA-256). Kept here
	# (rather than platform/crypto/Kconfig, AWP5) since it is this
	# module's own PSA usage, independent of which KeyBackend is linked
	# (APP_PLAN.md AWP3/AWP5). See platform/crypto/Kconfig for the
	# session/ephemeral-key PSA requirements.
	select PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_IMPORT
	select PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_EXPORT
	select PSA_WANT_ECC_SECP_R1_256
	select PSA_WANT_ALG_ECDSA
	select PSA_WANT_ALG_SHA_256
	help
	  PSA Crypto algorithm/key-type requirements for Access Credential
	  private-key storage, shared by the real and host-test-fake
	  KeyBackend implementations.

config ALIRO_UD_MAX_CREDENTIALS
	int "Maximum number of provisioned Access Credentials"
	default 4
	range 1 8
	help
	  Fixed capacity of the credential store. APP_PLAN.md AWP3 requires a
	  default of four. Each credential occupies one fixed persistent
	  storage slot (slot index = CredentialHandle - 1); handles are never
	  reused for a different slot.

config ALIRO_UD_MAX_BINDINGS_PER_CREDENTIAL
	int "Maximum reader_group_identifier bindings per Access Credential"
	default 16
	range 16 32
	help
	  Aliro 1.0 Specification section 6.2 and ALIRO-UD-SYRS-P1-009 require
	  at least 16 distinct reader_group_identifier bindings per credential,
	  each independently trusting a directly-bound Reader public key or a
	  Reader System Issuer CA public key (WP5.5 decision D9).

config ALIRO_UD_MAILBOX_MAX_SIZE
	int "Maximum provisionable per-credential mailbox size (bytes)"
	default 512
	range 1 4096
	help
	  Upper bound on the mailbox size staged as part of credential
	  provisioning (APP_PLAN.md AWP3/AWP6). The mailbox byte storage and
	  EXCHANGE semantics themselves are implemented in AWP6; AWP3 only
	  persists the provisioned size and permissions.

config ALIRO_UD_DOCUMENT_MAX_SIZE
	int "Maximum size of each optional Access/Revocation Document (bytes)"
	default 1024
	range 1 4096
	help
	  Upper bound on each optional Access Document and Revocation Document
	  staged as part of credential provisioning (APP_PLAN.md AWP3).

config ALIRO_UD_MAX_PREFERRED_BINDINGS
	int "Maximum distinct reader_group_identifier values with a recorded preferred credential"
	default 64
	help
	  Upper bound on the "preferred credential per shared reader
	  identifier" table (APP_PLAN.md AWP3, ALIRO-UD-SYRS-P1-010). Bounded
	  by the maximum possible number of distinct group identifiers across
	  every credential (ALIRO_UD_MAX_CREDENTIALS * ALIRO_UD_MAX_BINDINGS_PER_CREDENTIAL).

config ALIRO_UD_CREDENTIAL_KEY_ID_BASE
	hex "Base PSA persistent key ID for Access Credential private keys"
	default 0x00000100
	help
	  Each credential slot deterministically owns two adjacent persistent
	  PSA key IDs starting at this base: one for its committed key and one
	  "staged" companion ID used only while a replacement key is being
	  imported during a create/update transaction (APP_PLAN.md AWP3
	  persistent transaction journal). Slot i uses
	  (base + 2*i) committed / (base + 2*i + 1) staged. Must not overlap
	  any other persistent PSA key ID used by this application.

config ALIRO_UD_CREDENTIAL_KEY_BACKEND_REAL
	bool
	default y if !ZTEST
	help
	  Selects the real PSA/CRACEN/KMU-backed persistent key backend.
	  Disabled automatically under ZTEST, where host tests link an
	  application-owned in-memory fake instead (native_sim has no
	  hardware-backed trusted storage; APP_PLAN.md requires host tests to
	  use fakes/in-memory backends rather than depend on unavailable
	  hardware).

module = ALIRO_UD_CREDENTIAL
module-str = ALIRO_UD_CREDENTIAL
module-dep = LOG
module-help = Enables Aliro NFC User Device credential/trust storage log messages.
source "$(ZEPHYR_BASE)/subsys/logging/Kconfig.template.log_config"

endmenu # Credential and trust persistence (AWP3)
