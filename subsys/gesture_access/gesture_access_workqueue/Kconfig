config DOOR_LOCK_GESTURE_ACCESS_WORKQUEUE
	bool "Gesture access work queue"
	help
	  Dedicated work queue for gesture-access camera capture
	  and on-device inference work. Selected automatically by
	  CONFIG_DOOR_LOCK_GESTURE_ACCESS; do not enable directly.

if DOOR_LOCK_GESTURE_ACCESS_WORKQUEUE

config DOOR_LOCK_GESTURE_ACCESS_WORKQUEUE_INIT_PRIORITY
	int "Gesture access workqueue init priority"
	default APPLICATION_INIT_PRIORITY

config DOOR_LOCK_GESTURE_ACCESS_WORKQUEUE_STACK_SIZE
	int "Gesture access workqueue stack size"
	default 4096
	help
	  Stack size for the dedicated gesture-access workqueue thread that
	  runs camera capture work and on-device gesture
	  inference work.

config DOOR_LOCK_GESTURE_ACCESS_WORKQUEUE_PRIORITY
	int "Gesture access workqueue priority"
	default 11
	help
	  Cooperative thread priority of the dedicated gesture-access work
	  queue.

endif # DOOR_LOCK_GESTURE_ACCESS_WORKQUEUE
